API_URL=http://localhost:8000
JWT_SECRET=the-same-random-secret-configured-for-the-api
# Optional Google OAuth client settings. Set the same client ID and redirect URI in backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/session/google/callback
# Optional: set to your public app origin in production; leave unset for local development.
NEXT_PUBLIC_BASE_URL=
